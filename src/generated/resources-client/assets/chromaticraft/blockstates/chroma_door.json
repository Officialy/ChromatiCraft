        "model": "chromaticraft:block/chroma_door_core_closed"
      },
      "when": {
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "chromaticraft:block/chroma_door_down_closed"
      },
      "when": {
        "down": "true",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "chromaticraft:block/chroma_door_up_closed"
      },
      "when": {
        "open": "false",
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "chromaticraft:block/chroma_door_north_closed"
      },
      "when": {
        "north": "true",
        "open": "false"
      }
    },
    {
      "apply": {
        "model": "chromaticraft:block/chroma_door_south_closed"
      },
      "when": {
        "open": "false",
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "chromaticraft:block/chroma_door_west_closed"
      },
      "when": {
